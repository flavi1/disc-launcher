<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>disc-launcher</vendor>
  <vendor_url>https://github.com/flavi1/disc-launcher</vendor_url>
  <action id="io.github.flavi1.disclauncher.dump">
    <description>Read an optical disc with vendor-specific commands</description>
    <description xml:lang="fr">Lire un disque optique avec des commandes constructeur</description>
    <message>Authentication is required to read this disc with vendor-specific commands</message>
    <message xml:lang="fr">Une authentification est nécessaire pour lire ce disque avec des commandes constructeur</message>
    <defaults>
      <!-- Mot de passe administrateur, mémorisé quelques minutes. Les membres
           du groupe « disc-launcher » en sont dispensés par la règle
           /etc/polkit-1/rules.d/50-disc-launcher.rules. -->
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXECDIR@/disc-launcher/disc-launcher-helper</annotate>
  </action>
</policyconfig>
